{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "incremental-ridge-tool-report.schema.json",
  "title": "解析增量岭回归工具报告",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_type", "schema_version", "method_id", "method_version", "action", "status", "issues", "state_sha256", "state", "summary"],
  "properties": {
    "report_type": {"const": "IncrementalRidgeToolReport"},
    "schema_version": {"const": "0.3"},
    "method_id": {"const": "incremental_ridge_closed_form"},
    "method_version": {"const": "0.3"},
    "action": {"enum": ["initialize", "inspect", "update"]},
    "status": {"enum": ["passed", "completed", "rejected", "failed"]},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "path", "message"],
        "properties": {
          "code": {"type": "string"},
          "path": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    },
    "state_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "state": {"oneOf": [{"type": "null"}, {"$ref": "incremental-ridge-state.schema.json"}]},
    "summary": {"type": ["object", "null"]}
  }
}
