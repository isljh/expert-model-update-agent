{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-structure-analysis-report.schema.json",
  "title": "模型结构与可训练性分析报告",
  "description": "同一加载 worker 对已恢复权重的 torch.nn.Module 进行只读结构与参数检查；不执行 forward。",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_type", "schema_version", "status", "load_spec_id", "source_model_state", "general", "module_tree", "parameters", "parameter_summary", "buffers", "sharing_and_quantization", "forward_trace"],
  "properties": {
    "report_type": {"const": "ModelStructureAnalysisReport"},
    "schema_version": {"const": "0.2"},
    "status": {"const": "passed"},
    "load_spec_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_model_state": {
      "type": "object",
      "required": ["checkpoint_status", "checkpoint_parameters_loaded", "checkpoint_fully_matched", "missing_keys", "unexpected_keys"],
      "properties": {
        "checkpoint_status": {"const": "loaded"},
        "checkpoint_parameters_loaded": {"const": true},
        "checkpoint_fully_matched": {"const": true},
        "missing_keys": {"type": "array", "maxItems": 0},
        "unexpected_keys": {"type": "array", "maxItems": 0}
      }
    },
    "general": {
      "type": "object",
      "required": ["framework", "framework_version", "model_class_name", "model_python_module", "training_mode_at_analysis_start", "model_family", "model_family_evidence"],
      "properties": {
        "framework": {"const": "pytorch"},
        "framework_version": {"type": "string"},
        "model_class_name": {"type": "string"},
        "model_python_module": {"type": "string"},
        "training_mode_at_analysis_start": {"type": "boolean"},
        "model_family": {"enum": ["Linear", "MLP", "CNN", "RNN", "Transformer", "Hybrid", "Unknown"]},
        "model_family_evidence": {"type": "object"}
      }
    },
    "module_tree": {"type": "array", "items": {"type": "object"}},
    "parameters": {"type": "array", "items": {"type": "object"}},
    "parameter_summary": {
      "type": "object",
      "required": ["total_parameter_count", "trainable_parameter_count", "frozen_parameter_count", "unique_parameter_tensor_count"]
    },
    "buffers": {"type": "array", "items": {"type": "object"}},
    "sharing_and_quantization": {"type": "object"},
    "forward_trace": {"type": "object", "required": ["status", "reason"], "properties": {"status": {"const": "not_run"}}}
  }
}
