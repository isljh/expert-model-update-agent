{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-structure-analysis-report.schema.json",
  "title": "模型结构解析报告",
  "description": "同一实例化 worker 对真实 torch.nn.Module 的注册结构进行只读检查；不执行 forward。",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_type", "schema_version", "status", "proposal_id", "source_model_state", "general", "module_tree", "parameters", "parameter_summary", "buffers", "sharing_and_quantization", "forward_trace"],
  "properties": {
    "report_type": {"const": "ModelStructureAnalysisReport"},
    "schema_version": {"const": "0.1"},
    "status": {"const": "passed"},
    "proposal_id": {"type": "string", "minLength": 1},
    "source_model_state": {
      "type": "object",
      "required": ["checkpoint_status", "checkpoint_parameters_loaded", "checkpoint_fully_matched", "missing_keys", "unexpected_keys"],
      "properties": {
        "checkpoint_status": {"enum": ["loaded", "not_provided"]},
        "checkpoint_parameters_loaded": {"type": "boolean"},
        "checkpoint_fully_matched": {"type": "boolean"},
        "missing_keys": {"type": "array", "items": {"type": "string"}},
        "unexpected_keys": {"type": "array", "items": {"type": "string"}}
      }
    },
    "general": {
      "type": "object",
      "required": ["framework", "framework_version", "model_class_name", "model_python_module", "training_mode_at_analysis_start", "model_family", "model_family_evidence"],
      "properties": {
        "framework": {"const": "pytorch"},
        "framework_version": {"type": "string"},
        "model_class_name": {"type": "string"},
        "model_python_module": {"type": "string"},
        "training_mode_at_analysis_start": {"type": "boolean"},
        "model_family": {"enum": ["Linear", "MLP", "CNN", "RNN", "Transformer", "Hybrid", "Unknown"]},
        "model_family_evidence": {"type": "object"}
      }
    },
    "module_tree": {"type": "array", "items": {"type": "object", "required": ["module_path", "module_type", "child_module_paths", "structural_attributes"]}},
    "parameters": {"type": "array", "items": {"type": "object", "required": ["parameter_path", "shape", "parameter_count", "requires_grad", "alias_paths"]}},
    "parameter_summary": {"type": "object", "required": ["total_parameter_count", "trainable_parameter_count", "frozen_parameter_count", "unique_parameter_tensor_count"]},
    "buffers": {"type": "array", "items": {"type": "object", "required": ["buffer_path", "shape", "dtype", "device", "persistent"]}},
    "sharing_and_quantization": {"type": "object", "required": ["shared_module_groups", "shared_parameter_groups", "quantized_module_paths", "quantized_parameter_paths", "quantization_indicators_found"]},
    "forward_trace": {"type": "object", "required": ["status", "reason"], "properties": {"status": {"const": "not_run"}}}
  }
}
