{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-creation-validation-report.schema.json",
  "title": "模型创建方案静态验证报告",
  "description": "对一个或多个具体 ModelCreationProposal 的契约、源码锚点和对象引用进行薄静态核验后的机器报告；不检查 checkpoint 内容。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "report_type",
    "schema_version",
    "task_binding",
    "project_snapshot",
    "proposal_results",
    "selection",
    "readiness"
  ],
  "properties": {
    "report_type": {"const": "ModelCreationValidationReport"},
    "schema_version": {"const": "0.2"},
    "task_binding": {"type": ["object", "null"]},
    "project_snapshot": {"type": ["object", "null"]},
    "proposal_results": {"type": "array"},
    "selection": {"type": "object"},
    "readiness": {
      "type": "object",
      "required": [
        "ready_for_model_construction",
        "ready_for_checkpoint_load_attempt",
        "blockers"
      ],
      "properties": {
        "ready_for_model_construction": {"type": "boolean"},
        "ready_for_checkpoint_load_attempt": {"type": "boolean"},
        "blockers": {"type": "array"}
      }
    }
  }
}
