{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model-instantiation-report.schema.json",
  "title": "模型加载与实例化报告",
  "description": "声明模型类的创建、checkpoint 严格加载和可训练参数检查结果；blocked 不代表已经创建模型。",
  "type": "object",
  "additionalProperties": true,
  "required": ["report_type", "schema_version", "load_spec_id", "status", "checkpoint", "model", "error"],
  "properties": {
    "report_type": {"const": "ModelInstantiationReport"},
    "schema_version": {"const": "0.2"},
    "load_spec_id": {"type": ["string", "null"]},
    "runtime": {"type": "object"},
    "status": {"enum": ["completed", "failed", "blocked"]},
    "steps": {"type": "array"},
    "checkpoint": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["loaded", "failed", "not_attempted"]},
        "strict": {"type": "boolean"},
        "fully_matched": {"type": "boolean"},
        "missing_keys": {"type": "array"},
        "unexpected_keys": {"type": "array"}
      }
    },
    "model": {"type": ["object", "null"]},
    "task_binding": {"type": "object"},
    "delivery": {"type": "object"},
    "record": {"type": "object"},
    "structure_analysis": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "model-structure-analysis-report.schema.json"}
      ]
    },
    "error": {"type": ["object", "null"]},
    "execution_boundary": {"type": "object"}
  }
}
